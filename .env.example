# API (cmd/api) and content CLI (cmd/cq)
DATABASE_URL=postgres://codequest:codequest@localhost:5432/codequest?sslmode=disable
HTTP_ADDR=:8080
# Origins allowed to send state-changing requests (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the web app: magic-link emails and the GitHub OAuth redirect use it.
APP_URL=http://localhost:5173
# production refuses DEV_AUTH, requires SMTP_ADDR and an https APP_URL.
APP_ENV=development
# 1 enables "Dev sign-in" (no email). Local development and browser tests only.
DEV_AUTH=1

# Magic-link email. Without SMTP_ADDR (dev), links are written to the API log.
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=CodeQuest <no-reply@codequest.local>

# GitHub sign-in (optional): an OAuth app with callback APP_URL/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI tutor: "ollama" or empty (off). Development only for now: the API refuses
# to start with it set when APP_ENV=production. Needs `ollama serve` and the model.
TUTOR_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
TUTOR_MODEL=qwen2.5-coder:3b
# Hints per user per (local) day.
TUTOR_DAILY_LIMIT=5

# Web (Vite dev server): where /api is proxied
VITE_API_PROXY=http://localhost:8080
