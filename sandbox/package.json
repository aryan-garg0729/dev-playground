{
  "name": "codequest-sandbox",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "build": "npm run assets && tsc --noEmit -p . && vite build",
    "serve": "vite preview --host --port 5174 --strictPort",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "pyodide": "314.0.7",
    "sql.js": "1.15.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/sql.js": "1.4.11",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
